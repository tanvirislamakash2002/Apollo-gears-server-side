              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('get payments status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data[0]) {",
                  "  pm.collectionVariables.set('paymentId', res.data[0].id);",
                  "}"
                ],
