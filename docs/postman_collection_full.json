        {
          "name": "Get Cars (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/cars?page=1&limit=10&search=Tesla",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cars"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "Tesla" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('get cars status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data[0] && res.data[0].id) {",
                  "  pm.collectionVariables.set('carId', res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Car By ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
