{
  "info": {
    "name": "Apollo Gears Backend - Full API Automation",
    "description": "End-to-end Postman collection for Auth, Car, Rent, Bid, and Payment flows with variables, pre-request scripts, and post-response automation.",
    "_postman_id": "apollo-gears-full-automation-2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminEmail", "value": "admin@gmail.com" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "userEmail", "value": "user@example.com" },
    { "key": "userPassword", "value": "password123" },
    { "key": "userName", "value": "Test User" },
    { "key": "driverEmail", "value": "driver@example.com" },
    { "key": "driverPassword", "value": "password123" },
    { "key": "driverName", "value": "Test Driver" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "userAccessToken", "value": "" },
    { "key": "driverAccessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "carId", "value": "" },
    { "key": "rentId", "value": "" },
    { "key": "bidId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "paymentSessionId", "value": "" },
    { "key": "checkoutUrl", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('admin login status 200', () => pm.response.to.have.status(200));",
                  "if (res && res.data && res.data.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', res.data.accessToken);",
                  "  pm.environment.set('adminAccessToken', res.data.accessToken);",
                  "}",
                  "const setCookie = pm.response.headers.get('set-cookie');",
                  "if (setCookie) {",
                  "  const m = setCookie.match(/refreshToken=([^;]+)/);",
                  "  if (m) pm.collectionVariables.set('refreshToken', m[1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"{{userName}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
