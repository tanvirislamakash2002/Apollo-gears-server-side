generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String?
  name         String?
  role         Role      @default(USER)
  profileImage String?
  rating       Float     @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  rents        Rent[]
  bids         Bid[]     @relation("DriverBids")
  payments     Payment[]

  @@map("users")
}

model Car {
  id                String    @id @default(uuid())
  name              String
  brand             String
  model             String
  image             String?
  isDeleted         Boolean   @default(false)
  fuelType          FuelType
  passengerCapacity Int
  color             String
  condition         Condition
  rating            Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  rents             Rent[]

  @@map("cars")
}

model Rent {
  id            String     @id @default(uuid())
  startingPoint String
  destination   String
  rentStatus    RentStatus @default(PENDING)
  userId        String
  carId         String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id])
  car           Car        @relation(fields: [carId], references: [id])
  bids          Bid[]
  payments      Payment[]

  @@map("rents")
}

model Bid {
  id             String    @id @default(uuid())
  bidAmount      Float
  bidStatus      BidStatus @default(PENDING)
  driverLocation String
  rentId         String
  driverId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rent           Rent      @relation(fields: [rentId], references: [id], onDelete: Cascade)
  driver         User      @relation("DriverBids", fields: [driverId], references: [id], onDelete: Cascade)

  @@map("bids")
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  rentId                String
  amount                Float
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?
  stripePaymentIntentId String?
  paymentMethod         String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id])
  rent                  Rent          @relation(fields: [rentId], references: [id])

  @@map("payments")
}

enum Role {
  ADMIN
  USER
  DRIVER
}

enum FuelType {
  OCTANE
  HYBRID
  ELECTRIC
  DIESEL
  PETROL
}

enum Condition {
  NEW
  USED
}

enum RentStatus {
  PENDING
  ONGOING
  COMPLETED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
